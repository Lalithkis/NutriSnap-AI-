# Edge Function secrets — set with `supabase secrets set --env-file supabase/.env`
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Required for photo recognition and the assistant (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional model overrides (defaults: claude-opus-5-5)
VISION_MODEL=
ASSISTANT_MODEL=

# Optional: USDA FoodData Central key for foods missing from the local catalog (https://fdc.nal.usda.gov/api-key-signup)
FDC_API_KEY=
