{
  "expo": {
    "name": "NutriSnap AI",
    "slug": "nutrisnap-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nutrisnap",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1220",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.nutrisnap.app",
      "infoPlist": {
        "NSCameraUsageDescription": "NutriSnap uses the camera so you can photograph meals for food recognition.",
        "NSPhotoLibraryUsageDescription": "NutriSnap lets you choose meal photos from your library for food recognition."
      }
    },
    "android": {
      "package": "ai.nutrisnap.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0B1220"
      },
      "permissions": ["android.permission.CAMERA"]
    },
    "web": { "favicon": "./assets/favicon.png", "output": "single" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriSnap lets you choose meal photos from your library for food recognition.",
          "cameraPermission": "NutriSnap uses the camera so you can photograph meals for food recognition."
        }
      ]
    ],
    "experiments": { "typedRoutes": false }
  }
}
