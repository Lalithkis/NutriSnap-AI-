# ---- Mobile app (public, bundled into the app) ----
# From Supabase dashboard → Project Settings → API. The anon key is safe to ship; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Edge function secrets (NEVER put these in the app) ----
# Set with: supabase secrets set --env-file supabase/.env
# See supabase/.env.example
